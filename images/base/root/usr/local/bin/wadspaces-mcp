#!/usr/bin/python3
"""The `wadspaces` MCP server, for Claude Code in a wadspace: stdio relayed to
wadd's socket. wadd knows who's calling by the socket: nothing here says."""
import os
import socket
import sys
import threading
import time

PATH = "/run/wadspaces-agents/mcp.sock"

sock = socket.socket(socket.AF_UNIX)
for _ in range(50):
    try:
        sock.connect(PATH)
        break
    except OSError:
        time.sleep(0.2)
else:
    sys.exit("the wadspaces MCP server isn't here: is this wadspace's Agents switch on?")


def replies():
    with sock.makefile("rb") as f:
        for line in f:
            sys.stdout.buffer.write(line)
            sys.stdout.buffer.flush()
    os._exit(0)


threading.Thread(target=replies, daemon=True).start()
for line in sys.stdin.buffer:
    sock.sendall(line)
