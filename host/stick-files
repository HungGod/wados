#!/bin/bash
# What makes an installed host image a stick, written into its /var:
#
#   host/stick-files VAR TARGET [CLOUDFLARE_TOML [API [FIREBASE_TOML]]]
#
# VAR: the stick's /var. TARGET: the image machines follow. CLOUDFLARE_TOML:
# the keys, the stick's alone (without it, machines have no public address).
# API: a mock of Cloudflare's API, for tests. FIREBASE_TOML: the WadSpaces
# account's web app, which the installer gives each machine it installs
# (without it, they have no account). The image is public: neither file is
# ever in it, only here. Used by host/build.sh installer and tools/vm.sh
# stick, as root.
set -euo pipefail
VAR="${1:?stick-files VAR TARGET [CLOUDFLARE_TOML [API [FIREBASE_TOML]]]}"
TARGET="${2:?a target image}"
KEYS="${3:-}"
API="${4:-}"
FIREBASE="${5:-}"

install -d -m 0711 "${VAR}/lib/wados"
install -d -m 0700 "${VAR}/lib/wados/installer" "${VAR}/lib/wados/provision"
{
    echo '[installer]'
    echo "target = \"${TARGET}\""
    [[ -n "${API}" ]] && echo "api = \"${API}\""
} > "${VAR}/lib/wados/installer/installer.toml"
chmod 0600 "${VAR}/lib/wados/installer/installer.toml"
if [[ -n "${KEYS}" ]]; then
    # Only the two sections machines need: never the file as it is.
    python3 - "${KEYS}" > "${VAR}/lib/wados/installer/cloudflare.toml.new" << 'PY'
import json, sys, tomllib
with open(sys.argv[1], "rb") as f:
    cf = tomllib.load(f)["cloudflare"]
tunnel = cf["tunnel"]
print("[cloudflare.tunnel]")
for k in ("dns_edit_api_token", "tunnel_creator_api_token"):
    print(f"{k} = {json.dumps(tunnel[k])}")
turn = cf.get("turn")
if turn:
    print("[cloudflare.turn]")
    for k in ("token_id", "api_token"):
        print(f"{k} = {json.dumps(turn[k])}")
PY
    chmod 0600 "${VAR}/lib/wados/installer/cloudflare.toml.new"
    mv "${VAR}/lib/wados/installer/cloudflare.toml.new" "${VAR}/lib/wados/installer/cloudflare.toml"
fi
if [[ -n "${FIREBASE}" ]]; then
    # Only the web app's four keys: never the file as it is.
    python3 - "${FIREBASE}" > "${VAR}/lib/wados/installer/firebase.toml.new" << 'PY'
import json, sys, tomllib
with open(sys.argv[1], "rb") as f:
    c = tomllib.load(f)
missing = [k for k in ("api_key", "project_id") if not isinstance(c.get(k), str) or not c[k]]
if missing:
    sys.exit(f"stick-files: {sys.argv[1]} has no {', '.join(missing)}")
for k in ("api_key", "project_id", "auth_domain", "functions_region"):
    if isinstance(c.get(k), str) and c[k]:
        print(f"{k} = {json.dumps(c[k])}")
PY
    chmod 0600 "${VAR}/lib/wados/installer/firebase.toml.new"
    mv "${VAR}/lib/wados/installer/firebase.toml.new" "${VAR}/lib/wados/installer/firebase.toml"
    # WadSpaces Live has the account too (its first boot puts it at
    # /etc/wados/firebase.toml), so Sign in to WadSpaces links it as on a
    # machine; it shows in the account as wadspaces-live.
    install -m 0600 "${VAR}/lib/wados/installer/firebase.toml" "${VAR}/lib/wados/provision/firebase.toml"
fi
# WadSpaces Live: its first boot makes `live` (locked: nobody signs in as it)
# and says it's the stick. wados-provision.service does the rest, as on a machine.
echo wadspaces-live > "${VAR}/lib/wados/provision/hostname"
printf 'live\n!\n' > "${VAR}/lib/wados/provision/account"
: > "${VAR}/lib/wados/provision/live"
chmod 0600 "${VAR}/lib/wados/provision/account"
