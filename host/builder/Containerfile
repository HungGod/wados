# Builds WadOS's programs that run on the machine itself, against Fedora 44,
# the host image's own system:
#
#   wadd                  apps/wadd        the machine's daemon
#   wados-shell           apps/wados-shell the shell (GTK4, gtk4-layer-shell, PAM)
#   wadsctl               apps/wadsctl     what labwc's keybinds run
#   wadspaces-clipboard   crates/wad-clip  a wadspace's clipboard bridge, run by wadd
#
# host/build.sh builds this as localhost/wados-host-builder:44 and runs cargo
# in it with the checkout mounted read-only and cargo's caches under
# .build/host/. images/builder is the same Fedora and Rust without GTK: it
# builds what runs inside wadspaces.
FROM registry.fedoraproject.org/fedora:44@sha256:cb3bd21415bd82a2fae1a9379f3f972fa8e78d460c9f86101274d13230dd6fd6

# gtk4-devel brings pango, cairo, glib and graphene's; binutils (with gcc)
# strips the binaries.
RUN dnf -y --setopt=install_weak_deps=False install \
      gcc \
      gtk4-devel \
      gtk4-layer-shell-devel \
      pam-devel \
      pkgconf-pkg-config \
      rustup && \
    dnf clean all && rm -rf /var/cache/libdnf5 /var/log/dnf5.log*

# Rust 1.99 exactly, from rustup, as images/builder has it. RUSTUP_TOOLCHAIN
# overrides the repo's rust-toolchain.toml (which also asks for rustfmt and
# clippy, not needed here).
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin \
    RUSTUP_TOOLCHAIN=1.99 \
    CARGO_TERM_COLOR=never
RUN rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.99 && \
    chmod -R a+rX /usr/local/rustup /usr/local/cargo && \
    rustc --version && cargo --version
