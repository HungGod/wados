; WadOS's SELinux module (v1's wadspaces.cil). host/Containerfile loads it
; with semodule and checks it's there. SELinux stays enforcing.
;
; What a wadspace on the screen may use of the person's session besides the
; Wayland socket wadd makes it, which needs nothing here: wadd labels that
; socket and its folder for containers (apps/wadd/src/screen.rs), and each
; wadspace runs as container_t with categories of its own (wad-gen's
; units.rs: SecurityLabelLevel), apart from the others.
;
; PulseAudio: the session's socket (pipewire-pulse.socket's, which the
; person's systemd makes in /run/user/1000/pulse) is born wadspaces_sock_t,
; a type containers may write; connecting to it is connecting to the
; session (unconfined_t). wadd also labels it so as it binds PulseAudio's
; folder (only that folder) into a wadspace's screen folder, and asks the
; policy first (apps/wadd/src/selinux.rs: pulse_allowed, PULSE_SOCKET).
(type wadspaces_sock_t)
(roletype object_r wadspaces_sock_t)
(typeattributeset file_type (wadspaces_sock_t))
(typetransition unconfined_t user_tmp_t sock_file "native" wadspaces_sock_t)
(allow container_t wadspaces_sock_t (sock_file (getattr open read write append)))
(allow container_t unconfined_t (unix_stream_socket (connectto)))

; The shared memory the session's labwc hands a wadspace's labwc on its
; socket: wlroots makes it in /dev/shm (user_tmp_t) and passes only the fd
; (its DMA-BUF format table, keymaps). Without this the wadspace can't map
; the format table ("failed to mmap DMA-BUF format table": no GPU buffers).
; A wadspace reaches no user_tmp_t file by path: /dev/shm is its own, and
; its screen folder's pulse/ holds only the socket above. Found in the VM
; (tools/vm.sh check).
(allow container_t user_tmp_t (file (map read getattr)))

; greetd's config for this start (/usr/libexec/wados/greetd-config writes it,
; then restores its label): greetd runs as xdm_t, which reads files of its
; own type in /run, not /run's.
(filecon "/run/wados/greetd\.toml" file (system_u object_r xdm_var_run_t ((s0) (s0))))
