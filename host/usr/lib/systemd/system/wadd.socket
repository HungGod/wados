# wadd's API (/run/wadd/wadd.sock). systemd holds it, so the shell can
# connect while wadd (re)starts, and the first connection starts wadd.
#
# Who may use it is wadd's call, per request (apps/wadd/src/access.rs, by
# SO_PEERCRED): root and the groups in wad-config's [daemon] allow_groups.
# The socket lets in group wados: the machine's person (uid 1000, made by
# the installer) is in it.
[Unit]
Description=WadSpaces daemon API socket

[Socket]
ListenStream=/run/wadd/wadd.sock
SocketMode=0660
SocketUser=root
SocketGroup=wados
DirectoryMode=0755

[Install]
WantedBy=sockets.target
